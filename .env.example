# Copy this file to `.env.local` (or `.env`) and fill in the values from
# Supabase dashboard -> Project Settings -> API Keys.
# Use the PUBLISHABLE key (sb_publishable_...). Never put the secret key (sb_secret_...) here:
# every VITE_ variable is bundled into the public JavaScript.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only (no VITE_ prefix). Used by `bun run db:push` to apply migrations.
# Dashboard -> Connect -> Session pooler (the direct db.<ref>.supabase.co host needs IPv6).
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-your-region.pooler.supabase.com:5432/postgres
