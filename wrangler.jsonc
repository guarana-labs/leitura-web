// Cloudflare Workers config: serves the Vite build as static assets (no server code).
// https://developers.cloudflare.com/workers/static-assets/
{
  // Must match the Worker's name in the Cloudflare dashboard.
  "name": "leitura",
  "compatibility_date": "2026-11-01",
  "assets": {
    // Output of `bun run build` (vite build).
    "directory": "./dist",
    // Any path that isn't a file (e.g. /books/123, /reset-password) gets index.html,
    // so React Router handles it. Without this, reloading an inner page returns 404.
    "not_found_handling": "single-page-application"
  }
}
